<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MultiMedecin</AssemblyName>
    <RootNamespace>MultiDoctorSurgery</RootNamespace>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <RimWorldReferenceVersion Condition="'$(RimWorldVersion)' == '1.5'">1.5.4409</RimWorldReferenceVersion>
    <RimWorldReferenceVersion Condition="'$(RimWorldReferenceVersion)' == ''">1.6.4850</RimWorldReferenceVersion>
    <OutputPath>bin\$(Configuration)\$(RimWorldVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <DefineConstants Condition="'$(RimWorldVersion)' == '1.5'">$(DefineConstants);RIMWORLD_1_5</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldReferenceVersion)" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" PrivateAssets="all" />
  </ItemGroup>
</Project>
